{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".validate": "root.child('users').child(auth.uid).child('isAdmin').val() === true || ((!data.exists() || (newData.child('isAdmin').val() === data.child('isAdmin').val() && newData.child('role').val() === data.child('role').val() && newData.child('coins').val() === data.child('coins').val())) && (!newData.hasChild('isAdmin') || newData.child('isAdmin').val() === false))"
      }
    },
    "wallets": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "tournaments": {
      ".read": true,
      "$tournamentId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "customMatches": {
      ".read": "auth != null",
      "$matchId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('creatorId').val() === auth.uid) || (data.exists() && (data.child('creatorId').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)))"
      }
    },
    "customMatchRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && (data.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)))"
      }
    },
    "registrations": {
      ".read": "auth != null",
      "$uid": {
        "$regId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
        }
      }
    },
    "teams": {
      ".read": "auth != null",
      "$teamId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('captainId').val() === auth.uid) || (data.exists() && (data.child('captainId').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)))"
      }
    },
    "results": {
      ".read": "auth != null",
      "$matchId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('role').val() === 'Arbiter')"
      }
    },
    "transactions": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$txId": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
        }
      }
    },
    "coinTransactions": {
      ".read": "auth != null",
      "$txId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "payments": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$paymentId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || auth.uid === $userId)"
        }
      }
    },
    "redeems": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$redeemId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || auth.uid === $userId)"
        }
      }
    },
    "allRedeems": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$redeemId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "disputes": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$disputeId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || auth.uid === $uid)"
        }
      }
    },
    "reports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$reportId": {
        ".write": "auth != null"
      }
    },
    "communityChats": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && !root.child('chatRestrictions').child(auth.uid).child('muted').exists() && (newData.child('senderUid').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".validate": "newData.hasChildren(['messageId', 'senderUid', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 250"
      }
    },
    "tournamentChats": {
      "$tournamentId": {
        ".read": "auth != null",
        "$messageId": {
          ".write": "auth != null && !root.child('chatRestrictions').child(auth.uid).child('muted').exists() && (newData.child('senderUid').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
          ".validate": "newData.hasChildren(['messageId', 'senderUid', 'text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 250"
        }
      }
    },
    "notifications": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        "$notificationId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || auth.uid === $userId)"
        }
      }
    },
    "announcements": {
      ".read": "auth != null",
      "$announcementId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "favoritePlayers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$favId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "favorites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "paymentConfig": {
      ".read": "auth != null",
      "$method": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "topupProducts": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "topupOrders": {
      ".read": "auth != null",
      ".indexOn": ["uid", "status"],
      "$orderId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "appSettings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "auditLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$logId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "tournamentLeaderboards": {
      ".read": "auth != null",
      "$tournamentId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('role').val() === 'Arbiter')"
      }
    },
    "tournamentAnnouncements": {
      ".read": "auth != null",
      "$tournamentId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": "auth != null && (!data.exists() && newData.child('uid').val() === auth.uid)"
      }
    },
    "chatPresence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chatMutes": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "chatBlocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$targetUid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "chatReports": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$reportId": {
        ".write": "auth != null"
      }
    },
    "teamRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null"
      }
    },
    "chatRestrictions": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    }
  }
}
